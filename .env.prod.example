# =============================================================================
# Contoh environment untuk PRODUKSI (dkm.erdigma.id)
#
# Salin jadi `.env` DI SERVER, lalu isi nilainya. Jangan pernah commit `.env`
# yang sudah terisi — berkas ini hanya template.
#
#   cp .env.prod.example .env
#   docker compose -f compose.prod.yaml run --rm app php artisan key:generate --show
#   # tempel hasilnya ke APP_KEY di bawah
#   docker compose -f compose.prod.yaml up -d --build
# =============================================================================

APP_NAME="DKM Erdigma"
APP_URL=https://dkm.erdigma.id

# Wajib diisi. Ambil dari `php artisan key:generate --show`.
APP_KEY=

# Port di host yang diarahkan ke container. Biarkan 80 kalau container ini
# langsung menghadap internet; ubah kalau ada reverse proxy di depannya.
APP_EXPOSED_PORT=80

# ---- Database ---------------------------------------------------------------
DB_DATABASE=dkm_erdigma
DB_USERNAME=dkm
# Gunakan password acak yang panjang, bukan kata biasa.
DB_PASSWORD=
DB_ROOT_PASSWORD=

# ---- Lokasi masjid (dipakai menghitung jadwal sholat) -----------------------
DKM_MOSQUE_NAME="Musholla Erdigma"
# Musholla Erdigma, Blater, Purbalingga. Dicocokkan dengan catatan gedung
# "Erdigma Blater" di HRIS (-7.429184, 109.335308) — berjarak 76 m.
DKM_MOSQUE_ADDRESS="Blater, Purbalingga, Jawa Tengah, 53371"
DKM_LATITUDE=-7.429397
DKM_LONGITUDE=109.334649
DKM_ELEVATION=90
DKM_CALCULATION_METHOD=KEMENAG
