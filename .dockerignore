# Keeps the build context small and prevents secrets or host-built artefacts
# from leaking into the image.

.env
.env.*
!.env.example

.git
.gitignore
.github

vendor
node_modules
public/build
public/hot
public/storage

storage/app/private/*
!storage/app/private/.gitignore
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/testing/*
storage/framework/views/*
storage/logs/*

compose.yaml
compose.prod.yaml
Dockerfile
.dockerignore

tests
phpunit.xml
.phpunit.result.cache

.idea
.vscode
.fleet
.DS_Store
Thumbs.db

*.md
!README.md
